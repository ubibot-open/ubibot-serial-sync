# Template for the device-command-library update server. Copy this file to
# ".env" (same directory) and fill in real values -- ".env" itself is
# gitignored and never committed, since the URL/key may differ per
# environment (dev/staging/prod) and shouldn't require a rebuild to change.
# See docs/device-library-update-protocol.md for the full protocol.
#
# Where the app looks for ".env" at runtime, in order:
#   1. next to the built executable (production/deploy layout)
#   2. the current working directory (dev convenience)
# Not finding it (or leaving DEVICE_LIBRARY_API_BASE_URL blank) just disables
# remote updates -- the app falls back to the bundled resources/devices.json,
# nothing crashes.

# Base URL the app calls for the two device-library endpoints:
#   GET {DEVICE_LIBRARY_API_BASE_URL}/version  (cheap "is there an update?" check)
#   GET {DEVICE_LIBRARY_API_BASE_URL}/latest   (full devices.json-shaped payload)
# No trailing slash needed (the app strips one if present).
DEVICE_LIBRARY_API_BASE_URL=http://localhost:8980

# Optional. When non-empty, sent as the "X-Api-Key" header on every request.
# Leave blank if the backend doesn't require one.
DEVICE_LIBRARY_API_KEY=
