// Generated by CMake (configure_file()) from this .in template -- do not
// edit the copy in the build directory, it's overwritten on every
// reconfigure. Edit this file, or (for the version numbers themselves)
// CMakeLists.txt's top-of-file `project(VERSION ...)` instead -- see the
// comment there.
//
// Gives the built .exe a real Windows "file version" resource, so Explorer
// -> right-click -> Properties -> Details shows it (and so does anything
// else that reads a PE file's version info, e.g. some installers/deployment
// tools) -- without this, a Windows build has no version info baked into
// the binary at all, unlike the macOS bundle (MACOSX_BUNDLE_BUNDLE_VERSION
// in CMakeLists.txt) which already got one.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "UbiBot"
            VALUE "FileDescription", "UbiBot Serial Assistant"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "UbiBotSerialAssistant"
            VALUE "LegalCopyright", "Copyright (C) UbiBot"
            VALUE "OriginalFilename", "UbiBotSerialAssistant.exe"
            VALUE "ProductName", "UbiBot Serial Assistant"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
